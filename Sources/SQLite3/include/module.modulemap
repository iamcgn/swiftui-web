// Apple's `SQLite3` module for the web: SQLite's own amalgamation (Sources/SQLite3/sqlite3.c),
// so `import SQLite3` reaches the same C API as on iOS. `SQLite3.Ext` is the loadable
// extension header, as in Apple's module.
module SQLite3 {
    header "sqlite3.h"
    export *
    explicit module Ext {
        header "sqlite3ext.h"
        export *
    }
}
